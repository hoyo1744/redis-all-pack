{
  "uid": "redis-all-pack-hotkey",
  "title": "핫키 — 슬롯 쏠림과 분배",
  "tags": [
    "redis-all-pack",
    "week2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "① 쏠림 — 어느 노드가 타고 있나",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Redis 노드별 초당 명령 수",
      "description": "키 하나에 몰리면 클러스터가 3대여도 한 대만 올라간다. 완화 전략을 켜면 이 선들이 어떻게 갈리는지 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[30s])",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "piechart",
      "title": "노드별 명령 점유율",
      "description": "완화 없이 핫키를 때리면 한 조각이 전부를 차지한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (instance) (increase(redis_commands_processed_total[$__range]))",
          "legendFormat": "{{node}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "쏠림 비율 (최다 ÷ 전체)",
      "description": "1.00 에 가까울수록 한 노드가 다 받고 있다는 뜻. 3노드 균등이면 0.33 이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(increase(redis_commands_processed_total[$__range])) / sum(increase(redis_commands_processed_total[$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "② 완화 효과 — 원본까지 몇 건이 가나",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "조회 처리량과 지연",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\".*remaining.*\"}[30s]))",
          "legendFormat": "rps"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\".*remaining.*\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Redis 노드별 메모리",
      "description": "키 샤딩은 슬롯을 흩는 대신 키 개수를 N 배로 늘린다. 그 대가가 여기 보인다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "row",
      "title": "③ 키 분포",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "timeseries",
      "title": "Redis 노드별 키 개수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "redis_db_keys",
          "legendFormat": "{{instance}} db{{db}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "row",
      "title": "④ 클러스터 구성 — 지금 어떤 상태인가",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "클러스터 상태",
      "description": "1 = ok, 0 = fail. 슬롯이 하나라도 비면(cluster-require-full-coverage 기본 yes) 전체가 fail 로 떨어진다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "redis_cluster_state",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "마스터 / 알려진 노드",
      "description": "cluster_size = 슬롯을 가진 마스터 수. known_nodes 와 어긋나면 누군가 슬롯을 잃었다는 뜻이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 30
      },
      "targets": [
        {
          "expr": "redis_cluster_size",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "슬롯 커버리지",
      "description": "16384 여야 정상. 이 값이 줄면 그만큼의 키에 접근할 수 없다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 30
      },
      "targets": [
        {
          "expr": "redis_cluster_slots_ok",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 16384
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "의심받는 슬롯 (pfail / fail)",
      "description": "pfail 은 '내가 보기엔 저 노드 죽은 것 같다'(PFAIL) 상태의 슬롯 수다. gossip 이 끊기면 여기가 먼저 튄다. 마스터 과반이 동의하면 fail 로 승격된다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 15,
        "y": 30
      },
      "targets": [
        {
          "expr": "redis_cluster_slots_pfail",
          "legendFormat": "pfail {{instance}}"
        },
        {
          "expr": "redis_cluster_slots_fail",
          "legendFormat": "fail {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "gossip — 노드끼리 초당 몇 번 떠드나",
      "description": "클러스터 버스(포트+10000)로 오가는 하트비트다. 노드는 서로 PING/PONG 을 주고받으며 슬롯 비트맵(2KB)과 다른 노드에 대한 소문을 실어 나른다. 이 선이 0 으로 떨어지면 gossip 이 끊긴 것이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "rate(redis_cluster_stats_messages_ping_sent[1m])",
          "legendFormat": "ping ▶ {{instance}}"
        },
        {
          "expr": "rate(redis_cluster_stats_messages_pong_received[1m])",
          "legendFormat": "pong ◀ {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "gossip 트래픽 총량",
      "description": "주고받은 클러스터 버스 메시지 누적. 노드 수가 늘면 이 값이 제곱에 가깝게 증가한다 — 슬롯을 16384 개로 묶어둔 이유이기도 하다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "rate(redis_cluster_messages_sent_total[1m])",
          "legendFormat": "보냄 {{instance}}"
        },
        {
          "expr": "rate(redis_cluster_messages_received_total[1m])",
          "legendFormat": "받음 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    }
  ]
}